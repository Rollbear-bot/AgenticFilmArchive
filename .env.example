# 环境变量配置示例
# 复制此文件为.env并填写实际值

# Ark API密钥
ARK_API_KEY="your-ark-api-key"

# 嵌入模型
EMBED_MODEL="doubao-embedding-vision-250615"

# 向量数据库路径
VECTOR_DB_PATH="./chroma_multimodal"

# 资源目录
RES_DIR="./resources"

# 聊天模型
CHAT_MODEL="doubao-seed-1-6-251015"

# 视觉模型
VISION_MODEL="doubao-seed-1-6-251015"

# Ark 端点
ARK_ENDPOINT="https://ark.cn-beijing.volces.com/api/v3"

# 精排策略: local 或 alibaba (默认 alibaba，使用阿里百炼 API)
RERANK_STRATEGY="alibaba"

# 本地精排模型名称 (HuggingFace cross-encoder 模型)
RERANK_LOCAL_MODEL="BAAI/bge-reranker-base"

# 阿里百炼 Rerank API Key (使用 alibaba 策略时必填)
RERANK_ALIBABA_API_KEY=""

# 启用关键词匹配作为多路召回
BM25_ENABLED="true"
